<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkMenu" id="power-menu">
    <child>
      <object class="GtkMenuItem" id="shutdown">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="label" translatable="yes">⏻  Shutdown</property>
        <signal name="activate" handler="shutdown" />
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="reboot">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="label" translatable="yes">  Reboot</property>
        <signal name="activate" handler="reboot" />
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="suspend">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="label" translatable="yes">⏾  Suspend</property>
        <signal name="activate" handler="suspend" />
      </object>
    </child>
    <child>
      <object class="GtkMenuItem" id="hibernate">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="label" translatable="yes">  Hibernate</property>
        <signal name="activate" handler="hibernate" />
      </object>
    </child>
  </object>
</interface>