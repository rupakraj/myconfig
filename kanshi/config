profile office {
    output eDP-1 enable position 0,0 scale 1.5
    output DP-1 enable position 1920,0 scale 1.0
}

profile laptop-only {
    output eDP-1 enable position 0,0 scale 1.5
    output DP-1 disable
    output DP-3 disable
}

profile home {
    output eDP-1 enable position 0,0 scale 1.5
    output DP-3 enable position 1920,0 scale 1.0
}
